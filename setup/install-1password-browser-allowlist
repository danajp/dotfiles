#!/usr/bin/env bash
# Add Brave to 1Password's custom browser allowlist.
#
# Background: the 1Password desktop app only accepts native-messaging
# connections from a hardcoded set of browser binaries (chrome, chromium,
# firefox, vivaldi, …). Brave is not on that list. To allow it, the
# browser's executable filename must be written to
# /etc/1password/custom_allowed_browsers. That path is root-owned and
# outside $HOME, so home-manager standalone cannot manage it — we install
# it manually here, mirroring `setup/install-1password-polkit`.
#
# The matching per-user native-messaging manifest is rendered by
# home-manager via `xdg.configFile` in machines/modules/browser.nix.
# Both pieces are needed; this script handles only the system half.
#
# Usage: sudo setup/install-1password-browser-allowlist
#
# Idempotent: safe to re-run. Only `brave-browser` is added; if you start
# using a different Brave binary name (e.g. `brave`), add it here too.

set -euo pipefail

if [[ $EUID -ne 0 ]]; then
  echo "error: must run as root (use sudo)" >&2
  exit 1
fi

DEST=/etc/1password/custom_allowed_browsers

# The directory is created by the 1Password package on first run; create
# it ourselves if absent so this script works on a fresh install too.
install -d -m 0755 /etc/1password

# Browsers to allow. The filename must match the basename of the executable
# 1Password sees connecting — for Brave installed via home-manager that's
# `brave-browser` (the wrapper script created by programs.brave).
BROWSERS=(
  brave-browser
)

TMP="$(mktemp)"
trap 'rm -f "$TMP"' EXIT

{
  echo "# Managed by setup/install-1password-browser-allowlist."
  echo "# Lines starting with # are ignored by 1Password."
  printf '%s\n' "${BROWSERS[@]}"
} > "$TMP"

install -Dm0644 "$TMP" "$DEST"

echo "installed: $DEST"
printf '  allowed: %s\n' "${BROWSERS[@]}"
echo
echo "Restart the 1Password desktop app and the Brave extension after this"
echo "so they re-read their integration state."
