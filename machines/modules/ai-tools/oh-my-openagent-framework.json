{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/master/assets/oh-my-opencode.schema.json",

  "_comment": "Model assignments for framework (Anthropic + OpenAI direct API). Rationale: Opus orchestrates, GPT-5 reasons, Codex executes long deep work, Sonnet handles parallel cheap-and-cheerful sub-agents. See ~/.cache/opencode/node_modules/oh-my-openagent/README.md for upstream defaults.",

  "agents": {
    "sisyphus": {
      "model": "openai/gpt-5.5"
    },
    "prometheus": {
      "model": "anthropic/claude-opus-4-8"
    },

    "hephaestus": {
      "model": "openai/gpt-5.3-codex"
    },
    "atlas": {
      "model": "openai/gpt-5.3-codex"
    },

    "oracle": {
      "model": "openai/gpt-5.5-pro"
    },
    "metis": {
      "model": "openai/gpt-5.5"
    },
    "momus": {
      "model": "openai/gpt-5.5"
    },

    "sisyphus-junior": {
      "model": "anthropic/claude-sonnet-4-6"
    },
    "explore": {
      "model": "anthropic/claude-sonnet-4-6"
    },
    "librarian": {
      "model": "anthropic/claude-sonnet-4-6"
    },
    "frontend-ui-ux-engineer": {
      "model": "anthropic/claude-sonnet-4-6"
    },
    "document-writer": {
      "model": "anthropic/claude-sonnet-4-6"
    },
    "multimodal-looker": {
      "model": "anthropic/claude-sonnet-4-6"
    }
  }
}
