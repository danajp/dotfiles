// Framework omo.jsonc skeleton.
// Update the provider/model IDs to match the providers you have connected on this machine.
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
  "[native]": {
    "categories": {
      "quick": { "model": "openai/gpt-5.6-luna-fast" },
      "unspecified-low": { "model": "openai/gpt-5.6-luna-fast" },
      "deep-low": { "model": "anthropic/claude-fable-5-1" },
      "writing": { "model": "anthropic/claude-opus-5-5" },
      "artistry": { "model": "anthropic/claude-opus-5-5" },
      "visual-engineering": { "model": "openai/gpt-6-astra-pro" },
      "unspecified-high": { "model": "anthropic/claude-opus-5-5" },
      "deep-high": { "model": "anthropic/claude-opus-5-5" },
      "architect": { "model": "openai/gpt-6-astra-pro" },
      "ultrabrain": { "model": "anthropic/claude-opus-5-5" }
    },
    "agents": {
      "explore": { "model": "openai/gpt-5.6-luna-fast" },
      "librarian": { "model": "openai/gpt-5.6-luna-fast" },
      "plan-consultant": { "model": "anthropic/claude-opus-5-5" },
      "plan-reviewer": { "model": "anthropic/claude-opus-5-5" }
    },
    "task": {
      "team": {
        "max_wall_clock_minutes": 300
      }
    }
  }
}
