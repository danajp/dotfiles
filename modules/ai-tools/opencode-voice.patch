+function createOpencodeComplete(pluginOptions, logger, client) {
+  const ref = String(pluginOptions.opencodeModel);
+  const slash = ref.indexOf("/");
+  const model = { providerID: ref.slice(0, slash), modelID: ref.slice(slash + 1) };
+
+  return async function complete({ system, prompt }) {
+    if (slash <= 0) return { text: null, error: `Invalid opencodeModel: ${ref}` };
+    const text = system ? `<instructions>\n${system}\n</instructions>\n\n${prompt}` : prompt;
+
+    let sessionID = null;
+    try {
+      const created = await client.session.create({ title: "opencode-voice normalize" });
+      sessionID = created?.data?.id;
+      if (!sessionID) return { text: null, error: "Failed to create normalization session" };
+
+      logger?.log?.("LLM", `opencode completion model=${ref} promptChars=${prompt.length}`, "debug");
+      const result = await client.session.prompt({
+        sessionID,
+        model,
+        tools: { "*": false },
+        parts: [{ type: "text", text }],
+      });
+      const info = result?.data?.info;
+      if (info?.error) {
+        const msg = info.error.data?.message || info.error.name || "unknown error";
+        return { text: null, error: `LLM error: ${msg}` };
+      }
+      const out = (result?.data?.parts || [])
+        .filter((p) => p.type === "text" && !p.synthetic)
+        .map((p) => p.text)
+        .join("")
+        .trim();
+      return out ? { text: out } : { text: null, error: "Empty LLM response" };
+    } catch (err) {
+      logger?.log?.("LLM", `opencode completion error: ${err.message}`, "warn");
+      return { text: null, error: `LLM error: ${err.message}` };
+    } finally {
+      if (sessionID) {
+        await client.session.delete({ sessionID }).catch(() => {});
+      }
+    }
+  };
+}
